# Optional. Without these, the app falls back to free no-key sources
# (Open-Meteo + NWS) and silently degrades. Each key is server-side only;
# nothing ships in the client bundle.

# EPA AirNow — real station-measured air quality (US-only).
# Free key: https://docs.airnowapi.org/account/request/
AIRNOW_API_KEY=

# Synoptic Mesonet — ground-truth observations from ~50K stations
# (CWOP, RAWS, mesonets, NWS feeds), often closer to a course than the
# nearest ASOS/AWOS the NWS observation path uses.
# Free public token: https://customer.synopticdata.com/credentials/
SYNOPTIC_TOKEN=
